<idea-plugin>
    <id>com.ijson.IJSON</id>
    <name>IJSON</name>
    <version>1.0.0</version>
    <vendor email="alen.mark.wang@gmail.com" url="https://github.com/wangcongisqian/IJSON">IJSON Team</vendor>

    <description><![CDATA[
        <h2>IntelliJ IDEA JSON</h2>
        <p>A powerful JSON processing plugin with support for:</p>
        <ul>
            <li><b>JSON validation</b>: Validate selected text or the current file</li>
            <li><b>JSON formatting</b>: Format JSON and explore it in an interactive tree with collapsible nodes and support for adding, deleting, and editing values</li>
            <li><b>JSON creation</b>: Generate JSON from templates or input such as key-value pairs and descriptive text</li>
        </ul>
        <p>Use the editor context menu or the Tools → IJSON menu to access these features.</p>
    ]]>
    </description>

    <change-notes><![CDATA[
        <h3>1.0.0</h3>
        <ul>
            <li>Added JSON validation</li>
            <li>Added JSON formatting and interactive tree editing (collapse/expand and add/delete nodes)</li>
            <li>Added JSON creation and smart generation</li>
        </ul>
    ]]></change-notes>

    <!-- Compatible with IntelliJ IDEA 2024.3+ -->
    <idea-version since-build="243" until-build="253.*"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window for interactive JSON tree editing -->
        <toolWindow id="IJSON"
                    anchor="right"
                    icon="AllIcons.FileTypes.Any_type"
                    factoryClass="com.ijson.plugin.ui.JsonToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Main menu group under Tools -->
        <group id="IJSON.Menu" text="IJSON" description="JSON tools" popup="false">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="IJSON.ValidateJson"
                    class="com.ijson.plugin.actions.ValidateJsonAction"
                    text="Validate JSON"
                    description="Validate whether the selected text or file contains valid JSON">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt J" second-keystroke="V"/>
            </action>

            <action id="IJSON.BeautifyJson"
                    class="com.ijson.plugin.actions.BeautifyJsonAction"
                    text="Format JSON (Tree Editor)"
                    description="Format JSON and display it in an interactive tree with support for adding and deleting nodes">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt J" second-keystroke="B"/>
            </action>

            <action id="IJSON.NewJson"
                    class="com.ijson.plugin.actions.NewJsonAction"
                    text="Create / Generate JSON"
                    description="Generate JSON from a template or from input content">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt J" second-keystroke="N"/>
            </action>

            <separator/>

            <action id="IJSON.OpenToolWindow"
                    class="com.ijson.plugin.actions.OpenJsonToolWindowAction"
                    text="Open IJSON Tool Window"
                    description="Open the interactive JSON tree editor"/>
        </group>

        <!-- Editor context menu -->
        <group id="IJSON.EditorPopup" text="IJSON" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <reference ref="IJSON.ValidateJson"/>
            <reference ref="IJSON.BeautifyJson"/>
            <reference ref="IJSON.NewJson"/>
        </group>
    </actions>
</idea-plugin>
